# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored -- never commit real secrets.
# See 04-BUILD-STANDARDS.md sec 4 for how production secrets are set (Vercel CLI, not pasted in a dashboard).

# --- Supabase (Phase 0) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (used from Phase 3 onward, wired in Phase 0 so the adapter exists) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Provider switches -- see 01-ARCHITECTURE-AND-PORTABILITY.md sec 7 ---
# Changing these to aws-rds / cognito / s3 later is a config change, not a
# rewrite, IF every module has respected the adapter boundary in lib/.
DB_PROVIDER=supabase
AUTH_PROVIDER=supabase
STORAGE_PROVIDER=supabase
